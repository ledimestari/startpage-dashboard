# Copy this file to config.env and fill in your own values.
# config.env is read by ./serve_dashboard on startup (and re-read
# whenever the script restarts - it is not hot-reloaded).

# --- Dashboard server ---
# Bind address / port for the dashboard's own web server.
# 0.0.0.0 makes it reachable from other devices on your LAN - with the
# server running on 192.168.1.131, the dashboard will be at
# http://192.168.1.131:2954/
HOST=0.0.0.0
PORT=2954

# Name used in the "Good afternoon, <name>" greeting.
DASHBOARD_NAME=Anders

# Path to the message-of-the-day file. A separate script is expected
# to (re)write this file's contents; serve_dashboard only reads it.
MOTD_PATH=motd.txt

# Path to the file that stores your sections/services (everything you
# edit under "Manage services"). Created automatically on first run
# with the example services baked into this dashboard, so you don't
# need to touch this.
SERVICES_PATH=services.json

# --- Beszel ---
# Base URL of your Beszel hub (no trailing slash), e.g. http://192.168.1.123:8090
BESZEL_URL=http://127.0.0.1:8090

# A Beszel user's login. A read-only Beszel user is recommended -
# this account only needs permission to view systems, not manage them.
BESZEL_EMAIL=you@example.com
BESZEL_PASSWORD=changeme

# Comma-separated list of Beszel system names to show in the sidebar,
# in the order they should appear. Names must match exactly what each
# system is called in Beszel.
DASHBOARD_SERVERS=LocalServer,InternetServer,NASbox,DownloadClient

# Label shown above the storage gauge at the bottom of the sidebar, e.g.
# "HassiVault storage". Leave blank to just show "Storage". The gauge's
# used/total figures come from NAS_DISK_PATH below, not from Beszel.
VAULT_SYSTEM_NAME=NAS STORAGE

# --- Storage gauge ---
# Path to a plain text file containing "<used>/<total>" in GB, e.g.
# "50/257". Whatever writes/updates this file is up to you (a cron job,
# a NAS script, etc.) - serve_dashboard only reads it. If the file is
# missing or doesn't parse, the storage gauge is just hidden.
NAS_DISK_PATH=nas_disk.txt

# --- Clock ---
# 12, 24, or auto (default - follows the browser's locale).
CLOCK_FORMAT=auto

# IANA timezone name for the clock and the "Good morning/afternoon/
# evening" greeting, e.g. Europe/Helsinki. Leave blank to use the
# server's own local system time (the previous, default behavior).
TIMEZONE=
